; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Carefree"
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/show_image=false
boot_splash/bg_color=Color(0, 0, 0, 1)

[small_world]

; Detailed-vs-primitive courtyard asset toggle -- read by
; scripts/logic/asset_mode.gd (AssetMode.use_detailed()), consumed by
; tools/_bootstrap_courtyard.gd at generation time. true = vendored
; glTF/glb props (bench/tree/bush/lamp/rock); false = today's
; Box/Sphere/Cylinder primitives, for fast iteration. Flip this, then
; re-run `godot --headless --path godot --script
; res://tools/_bootstrap_courtyard.gd` followed by `--import`. See
; ASSET_CREDITS.md's "Detailed vs primitive assets" section.
assets/use_detailed=true

[gui]

theme/custom="res://resources/ui/theme.tres"

[autoload]

Game="*res://scripts/game.gd"
AudioDirector="*res://scripts/audio_director.gd"
DebugBridge="*res://scripts/debug_bridge.gd"
DebugOverlay="*res://scripts/debug_overlay.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

